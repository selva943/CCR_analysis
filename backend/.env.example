# Supabase project (Dashboard → Settings → API / Connect)
SUPABASE_DB_URL=postgresql://postgres.SERVICE_ROLE:PASSWORD@aws-0.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# JWT signing secret (Dashboard → Settings → API → JWT Secret). Required so the
# backend can verify the dashboard users' access tokens.
SUPABASE_JWT_SECRET=

# Optional: shared secret required in the X-Import-Token header for POST /api/import
CCR_IMPORT_TOKEN=

# Comma separated; '*' allows any origin (default)
ALLOWED_ORIGINS=*

# xlsx upload cap in MB (default 200)
MAX_UPLOAD_MB=200
